# Dependências e saídas do site (gitpages/)
# O build é feito pelo workflow deploy-docs.yml; dist/ não vai para o repositório.
gitpages/node_modules/
gitpages/dist/
gitpages/.astro/

# Qualquer node_modules em outra pasta
node_modules/

# Documentos de referência privados: nunca vão para o repositório público
referencias/

# Variáveis de ambiente e segredos
.env
.env.*
.env*.local

# Configuração local do Claude Code (por pessoa)
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini
*~

# Editores (settings.json do VS Code é compartilhado pelo time)
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# Exceção: o modelo de variáveis de ambiente é versionado
!.env.example
