{
  "components": {
    "schemas": {
      "AcceptInvitationRequest": {
        "description": "What the accountant sends from the invitation link.",
        "properties": {
          "invitation_code": {
            "title": "Invitation Code",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "invitation_code",
          "username",
          "password"
        ],
        "title": "AcceptInvitationRequest",
        "type": "object"
      },
      "AccountantRequest": {
        "description": "Name and login typed by the manager; emptiness is checked by the access module.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "name",
          "username"
        ],
        "title": "AccountantRequest",
        "type": "object"
      },
      "AssignmentRequest": {
        "description": "Member who becomes the responsible; the id is checked against the firm of the session.",
        "properties": {
          "member_id": {
            "title": "Member Id",
            "type": "string"
          }
        },
        "required": [
          "member_id"
        ],
        "title": "AssignmentRequest",
        "type": "object"
      },
      "AssignmentResponse": {
        "description": "Who is responsible for a client; `responsible` is null when no one is.",
        "properties": {
          "responsible": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResponsibleResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "responsible"
        ],
        "title": "AssignmentResponse",
        "type": "object"
      },
      "BankAccountPatch": {
        "description": "Fields to change; the registry looks at which ones were sent (plan answer P4).",
        "properties": {
          "bank": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bank"
          },
          "first_month": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Month"
          },
          "last_month": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Month"
          },
          "nickname": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nickname"
          }
        },
        "title": "BankAccountPatch",
        "type": "object"
      },
      "BankAccountRequest": {
        "description": "New bank account. Every field is optional here so the registry answers with the\nmessage of the ficha when one is missing (plan CAD-04, T5).",
        "properties": {
          "bank": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bank"
          },
          "first_month": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Month"
          },
          "last_month": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Month"
          },
          "nickname": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nickname"
          }
        },
        "title": "BankAccountRequest",
        "type": "object"
      },
      "BankAccountResponse": {
        "description": "Bank account as shown to the member: never the firm id.",
        "properties": {
          "bank": {
            "title": "Bank",
            "type": "string"
          },
          "bank_name": {
            "title": "Bank Name",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "first_month": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Month"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_month": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Month"
          },
          "nickname": {
            "title": "Nickname",
            "type": "string"
          }
        },
        "required": [
          "id",
          "bank",
          "bank_name",
          "nickname",
          "currency",
          "first_month",
          "last_month"
        ],
        "title": "BankAccountResponse",
        "type": "object"
      },
      "ClientRequest": {
        "description": "Name and CNPJ typed by the manager. Emptiness and format are checked by the registry,\nso the user gets the message of the ficha, not a validation text in English.",
        "properties": {
          "cnpj": {
            "title": "Cnpj",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "cnpj"
        ],
        "title": "ClientRequest",
        "type": "object"
      },
      "ClientResponse": {
        "description": "Client as shown to the member: never the firm id (plan CAD-03, D5).",
        "properties": {
          "cnpj": {
            "title": "Cnpj",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "cnpj"
        ],
        "title": "ClientResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthStatus": {
        "description": "Body of a healthy answer: the API is up and the database answered.",
        "properties": {
          "api": {
            "const": "up",
            "title": "Api",
            "type": "string"
          },
          "database": {
            "const": "connected",
            "title": "Database",
            "type": "string"
          }
        },
        "required": [
          "api",
          "database"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "InvitationResponse": {
        "description": "Person with the invitation just issued: the only time the code is shown.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "invitation_code": {
            "title": "Invitation Code",
            "type": "string"
          },
          "invitation_path": {
            "title": "Invitation Path",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "manager",
              "accountant"
            ],
            "title": "Role",
            "type": "string"
          },
          "status": {
            "enum": [
              "ativo",
              "convite_pendente",
              "convite_vencido",
              "sem_convite"
            ],
            "title": "Status",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "username",
          "role",
          "status",
          "invitation_code",
          "invitation_path",
          "expires_at"
        ],
        "title": "InvitationResponse",
        "type": "object"
      },
      "MessageResponse": {
        "description": "A short confirmation in plain Portuguese.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "MessageResponse",
        "type": "object"
      },
      "PersonResponse": {
        "description": "Person of the firm in the manager's list. Never carries a code, hash or password.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "manager",
              "accountant"
            ],
            "title": "Role",
            "type": "string"
          },
          "status": {
            "enum": [
              "ativo",
              "convite_pendente",
              "convite_vencido",
              "sem_convite"
            ],
            "title": "Status",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "username",
          "role",
          "status"
        ],
        "title": "PersonResponse",
        "type": "object"
      },
      "Problem": {
        "description": "Error body in RFC 9457 (application/problem+json).",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ResponsibleResponse": {
        "description": "Active responsible of a client: id of the member, name and login.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "username"
        ],
        "title": "ResponsibleResponse",
        "type": "object"
      },
      "SessionIdentity": {
        "description": "Who is signed in. Never carries the password, its hash or the session token.",
        "properties": {
          "firm_id": {
            "title": "Firm Id",
            "type": "string"
          },
          "firm_name": {
            "title": "Firm Name",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "manager",
              "accountant"
            ],
            "title": "Role",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "name",
          "role",
          "firm_id",
          "firm_name"
        ],
        "title": "SessionIdentity",
        "type": "object"
      },
      "SignInRequest": {
        "description": "Credentials typed on the sign-in page. The password may be empty (ACE-01, c6).",
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "SignInRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Lastro",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/accountants": {
      "get": {
        "description": "People of the firm, the manager included, with their password situation (ACE-02, c1).",
        "operationId": "list_accountants_api_v1_accountants_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PersonResponse"
                  },
                  "title": "Response List Accountants Api V1 Accountants Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "summary": "List Accountants"
      },
      "post": {
        "description": "Register an accountant without a password; the invitation code comes back once\n(ACE-02, c1, c4, c8).",
        "operationId": "register_accountant_api_v1_accountants_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Register Accountant"
      }
    },
    "/api/v1/accountants/{member_id}/invitation": {
      "delete": {
        "description": "Cancel the pending invitation; 204 even when there is none (ACE-02, c5, c8).",
        "operationId": "cancel_invitation_api_v1_accountants__member_id__invitation_delete",
        "parameters": [
          {
            "in": "path",
            "name": "member_id",
            "required": true,
            "schema": {
              "title": "Member Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel Invitation"
      },
      "post": {
        "description": "Issue a new invitation; the previous code stops working (ACE-02, c5, c8, c9).",
        "operationId": "issue_invitation_api_v1_accountants__member_id__invitation_post",
        "parameters": [
          {
            "in": "path",
            "name": "member_id",
            "required": true,
            "schema": {
              "title": "Member Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Issue Invitation"
      }
    },
    "/api/v1/clients": {
      "get": {
        "description": "Clients of the firm that the member may see (CAD-03, c1, c3; P-09).",
        "operationId": "list_clients_api_v1_clients_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ClientResponse"
                  },
                  "title": "Response List Clients Api V1 Clients Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
