# Copie para .env (cp .env.example .env) e troque os valores antes de usar fora da sua máquina.
# O .env não é versionado. Plano NUC-01: D5 (papéis do banco) e D7 (duas URLs).

# Superusuário do PostgreSQL: só cria os papéis na primeira subida do serviço db.
POSTGRES_USER=postgres
POSTGRES_DB=lastro
POSTGRES_PASSWORD=exemplo-troque-superusuario

# Senhas dos dois papéis criados por migrations/bootstrap/create_roles.sh.
OWNER_DB_PASSWORD=exemplo-troque-dono
APP_DB_PASSWORD=exemplo-troque-aplicacao

# A API conecta como lastro_app (lê e grava; não muda a estrutura do banco).
DATABASE_URL=postgresql+psycopg://lastro_app:exemplo-troque-aplicacao@db:5432/lastro
# Só o Alembic usa esta URL, como lastro_owner (dono das tabelas).
MIGRATIONS_DATABASE_URL=postgresql+psycopg://lastro_owner:exemplo-troque-dono@db:5432/lastro

# IA-01 (D-03): proteção de nomes antes de qualquer envio à IA.
# estrito (padrão), pessoas_protegidas ou desligado. Valor desconhecido impede a API de subir.
NAME_PROTECTION_LEVEL=estrito
